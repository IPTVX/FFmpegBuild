+/* Whether the first frame of a Temporal Unit is a Key Frame that refreshes
+ * every reference slot. Reads uncompressed_header() up to refresh_frame_flags. */
+static int is_full_key_frame(const AV1FrameHeaderContext *fh, const uint8_t *buf,
+                             int size, int temporal_id, int spatial_id)
+{
+    GetBitContext gb;
+    int frame_type, show_frame, allow_screen_content_tools;
+
+    if (fh->reduced_still_picture_header)
+        return 1;
+
+    if (init_get_bits8(&gb, buf, size) < 0)
+        return 0;
+
+    if (get_bits1(&gb)) // show_existing_frame
+        return 0;
+    frame_type = get_bits(&gb, 2);
+    if (frame_type != AV1_FRAME_KEY)
+        return 0;
+    show_frame = get_bits1(&gb);
+    if (show_frame) // refresh_frame_flags is allFrames
+        return 1;
+
+    skip_bits(&gb, 3); // showable_frame, error_resilient_mode, disable_cdf_update
+    if (fh->seq_force_screen_content_tools == 2)
+        allow_screen_content_tools = get_bits1(&gb);
+    else
+        allow_screen_content_tools = fh->seq_force_screen_content_tools;
+    if (allow_screen_content_tools && fh->seq_force_integer_mv == 2)
+        skip_bits1(&gb); // force_integer_mv
+    skip_bits_long(&gb, fh->frame_id_length); // current_frame_id
+    skip_bits1(&gb); // frame_size_override_flag
+    skip_bits(&gb, fh->order_hint_bits); // order_hint
+    if (fh->decoder_model_info_present_flag && get_bits1(&gb)) { // buffer_removal_time_present_flag
+        for (int i = 0; i < fh->operating_points_cnt; i++) {
+            int idc = fh->operating_point_idc[i];
+            if (!fh->decoder_model_present_for_this_op[i])
+                continue;
+            if (!idc || (((idc >> temporal_id) & 1) && ((idc >> (spatial_id + 8)) & 1)))
+                skip_bits_long(&gb, fh->buffer_removal_time_length);
+        }
+    }
+
+    return get_bits_left(&gb) >= 8 && get_bits(&gb, 8) == 0xFF; // refresh_frame_flags
+}
+
+int ff_av1_is_random_access_point(const uint8_t *buf, int size)
+{
+    AV1SequenceParameters seq;
+    AV1FrameHeaderContext fh;
+    int seq_header = 0;
+
+    while (size > 0) {
+        int64_t obu_size;
+        int start_pos, type, temporal_id, spatial_id;
+        int len = parse_obu_header(buf, size, &obu_size, &start_pos,
+                                   &type, &temporal_id, &spatial_id);
+        if (len < 0)
+            return 0;
+
+        switch (type) {
+        case AV1_OBU_SEQUENCE_HEADER:
+            if (!obu_size || parse_sequence_header(&seq, &fh, buf + start_pos, obu_size) < 0)
+                return 0;
+            seq_header = 1;
+            break;
+        case AV1_OBU_FRAME_HEADER:
+        case AV1_OBU_FRAME:
+            return seq_header && obu_size &&
+                   is_full_key_frame(&fh, buf + start_pos, obu_size, temporal_id, spatial_id);
+        default:
+            break;
+        }
+        size -= len;
+        buf  += len;
+    }
+
+    return 0;
+}
+
