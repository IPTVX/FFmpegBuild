+/**
+ * Check whether a Temporal Unit is a random access point: it carries a
+ * Sequence Header OBU and its first frame is a Key Frame that refreshes every
+ * reference slot. That includes a hidden Key Frame (show_frame equal to 0),
+ * the Delayed Random Access Point forward key frame encodes are built on,
+ * as long as nothing decoded before it can be referenced after it.
+ *
+ * @param buf Temporal Unit in low overhead bitstream format
+ * @param size size in bytes of the input data buffer
+ *
+ * @return 1 if it is a random access point, 0 otherwise
+ */
+int ff_av1_is_random_access_point(const uint8_t *buf, int size);
+
 /**
  * Writes AV1 extradata (Sequence Header and Metadata OBUs) to the provided
  * AVIOContext.
